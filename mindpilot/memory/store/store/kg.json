    "paper:2504.03193v2": {
      "node_id": "paper:2504.03193v2",
      "node_type": "paper",
      "label": "Mamba as a Bridge: Where Vision Foundation Models Meet Vision Language Models for Domain-Generalized",
      "properties": {
        "year": "2025",
        "url": "https://arxiv.org/abs/2504.03193v2",
        "relevance": 0.995,
        "summary": {
          "method": "提出MFuser框架，利用Mamba高效融合视觉基础模型与视觉语言模型，解决长序列建模难题。",
          "conclusion": "实现了细粒度特征与文本对齐能力的有效结合，在保持线性复杂度的同时解决了融合难题。",
          "limitation": "现有方法忽略模型互补性，且基于注意力机制的融合在处理长序列时面临计算复杂度高的挑战。"
        }
      }
    },
