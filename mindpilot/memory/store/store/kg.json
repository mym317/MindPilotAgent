    "paper:2503.13440v2": {
      "node_id": "paper:2503.13440v2",
      "node_type": "paper",
      "label": "MaTVLM: Hybrid Mamba-Transformer for Efficient Vision-Language Modeling",
      "properties": {
        "year": "2025",
        "url": "https://arxiv.org/abs/2503.13440v2",
        "relevance": 0.917,
        "summary": {
          "method": "提出MaTVLM混合模型，用Mamba-2层替换预训练VLM中的部分Transformer解码器层，利用注意力关系初始化。",
          "conclusion": "旨在解决RNN长距离依赖问题，提升收敛速度与下游任务性能。",
          "limitation": "指出RNN模型存在难以捕捉长距离依赖、收敛慢、资源需求高的问题。"
        }
      }
    },
