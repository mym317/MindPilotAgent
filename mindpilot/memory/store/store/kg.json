    "paper:2511.16595v2": {
      "node_id": "paper:2511.16595v2",
      "node_type": "paper",
      "label": "TimeViper: A Hybrid Mamba-Transformer Vision-Language Model for Efficient Long Video Understanding",
      "properties": {
        "year": "2025",
        "url": "https://arxiv.org/abs/2511.16595v2",
        "relevance": 0.999,
        "summary": {
          "method": "提出TimeViper模型，采用混合Mamba-Transformer骨干网络，并引入TransV模块传输和压缩视觉Token。",
          "conclusion": "揭示了视觉到文本的信息聚合现象，通过混合架构有效处理长视频上下文并减少视觉Token冗余。",
          "limitation": "摘要内容不完整，未提及具体局限性。"
        }
      }
    },
