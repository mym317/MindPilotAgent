    "paper:2409.05395v2": {
      "node_id": "paper:2409.05395v2",
      "node_type": "paper",
      "label": "Shaking Up VLMs: Comparing Transformers and Structured State Space Models for Vision & Language Mode",
      "properties": {
        "year": "2024",
        "url": "https://arxiv.org/abs/2409.05395v2",
        "relevance": 0.999,
        "summary": {
          "method": "本研究用Mamba替代VLM中的Transformer，并在受控条件下测试高达3B参数的模型。",
          "conclusion": "Mamba在字幕、问答和阅读理解上优于Transformer，但在视觉定位上表现较差。",
          "limitation": "Mamba在视觉定位任务上落后于Transformer，且性能差距随模型规模扩大而加剧。"
        }
      }
    },
