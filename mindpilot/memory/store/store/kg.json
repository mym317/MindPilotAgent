    "paper:2412.09875v1": {
      "node_id": "paper:2412.09875v1",
      "node_type": "paper",
      "label": "Selective State Space Memory for Large Vision-Language Models",
      "properties": {
        "year": "2024",
        "url": "https://arxiv.org/abs/2412.09875v1",
        "relevance": 0.999,
        "summary": {
          "method": "提出状态空间记忆集成（SSMI），集成轻量级Mamba模块，仅更新少量参数以高效捕获长距离依赖。",
          "conclusion": "在COCO、VQA等基准测试中表现优异，验证了该方法在计算效率和可扩展性方面的优势。",
          "limitation": "摘要内容中断，未明确提及具体局限性。"
        }
      }
