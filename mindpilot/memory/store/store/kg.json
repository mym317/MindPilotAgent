    "paper:2503.10665v1": {
      "node_id": "paper:2503.10665v1",
      "node_type": "paper",
      "label": "Small Vision-Language Models: A Survey on Compact Architectures and Techniques",
      "properties": {
        "year": "2025",
        "url": "https://arxiv.org/abs/2503.10665v1",
        "relevance": 0.989,
        "summary": {
          "method": "综述sVLM架构（Transformer、Mamba及混合型），分析知识蒸馏、轻量级注意力及模态预融合等关键技术。",
          "conclusion": "分析TinyGPT-V等模型，揭示紧凑设计在资源受限环境下的高效性，明确准确性、效率与可扩展性间的权衡。",
          "limitation": "指出数据偏差等持续存在的挑战。"
        }
      }
    },
