    "paper:2601.06891v1": {
      "node_id": "paper:2601.06891v1",
      "node_type": "paper",
      "label": "CLIMP: Contrastive Language-Image Mamba Pretraining",
      "properties": {
        "year": "2026",
        "url": "https://arxiv.org/abs/2601.06891v1",
        "relevance": 0.99,
        "summary": {
          "method": "提出首个全基于Mamba的对比视觉语言模型CLIMP，用Mamba替换视觉和文本编码器，捕捉视觉空间归纳偏置。",
          "conclusion": "减少虚假相关性依赖，增强跨模态检索和分布外鲁棒性，ImageNet-O上超越CLIP-ViT-B 7.5%，支持可变分辨率。",
          "limitation": "提供的摘要文本未明确提及具体局限性。"
        }
      }
    },
