    "paper:2412.08388v1": {
      "node_id": "paper:2412.08388v1",
      "node_type": "paper",
      "label": "LOMA: Language-assisted Semantic Occupancy Network via Triplane Mamba",
      "properties": {
        "year": "2024",
        "url": "https://arxiv.org/abs/2412.08388v1",
        "relevance": 0.962,
        "summary": {
          "method": "提出LOMA网络，利用语言辅助和三平面Mamba，解决几何信息缺失和局部交互受限问题。",
          "conclusion": "摘要文本截断，未包含具体实验结论。",
          "limitation": "图像缺乏几何信息导致大场景预测困难，注意力机制复杂度限制了全局特征融合。"
        }
