    "paper:2408.10575v2": {
      "node_id": "paper:2408.10575v2",
      "node_type": "paper",
      "label": "MUSE: Mamba is Efficient Multi-scale Learner for Text-video Retrieval",
      "properties": {
        "year": "2024",
        "url": "https://arxiv.org/abs/2408.10575v2",
        "relevance": 0.949,
        "summary": {
          "method": "提出MUSE模型，利用特征金字塔生成多尺度表示，采用Mamba结构联合学习跨分辨率特征，实现高效线性复杂度建模。",
          "conclusion": "该方法克服了CLIP结构限制，通过多尺度表示提供更丰富的上下文信息，实现了高效的跨分辨率建模。",
          "limitation": "摘要内容不完整，未提及具体局限性。"
        }
